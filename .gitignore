# Python virtual environment (all deps live here; deleting the repo removes everything)
.venv/
__pycache__/
*.pyc

# Cloned evaluation targets (fetched at demo time, never vendored)
targets/

# SQLite finding store / index
*.db
*.sqlite3

# Per-target output directories (generated by runs)
out-bottle/
out-pyyaml/
out-werkzeug/

# Local secrets (never commit CURSOR_API_KEY or any key)
.env

# OS noise
.DS_Store

# Blog drafts and images (published elsewhere)
blog/

# Project CodeGuard rules fetched by scripts/fetch_codeguard.sh (not vendored)
vendor/codeguard/

# Throwaway agent workspaces (prevention experiment, LLM scratch dirs)
.scratch/
